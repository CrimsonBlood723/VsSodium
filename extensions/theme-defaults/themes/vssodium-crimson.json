{
	"$schema": "vscode://schemas/color-theme",
	"name": "VsSodium Crimson",
	"include": "./vssodium-dark.json",
	"type": "dark",
	"tokenColors": [
		{
			"scope": "entity.name.tag.svg",
			"settings": { "foreground": "#FF9EAE", "fontStyle": "bold" }
		},
		{
			"scope": "entity.other.attribute-name.svg",
			"settings": { "foreground": "#FFC6A0" }
		}
	],
	"colors": {
		"foreground": "#F5E9EC",
		"descriptionForeground": "#C5A9B0",
		"focusBorder": "#FF718D",
		"editor.background": "#181216",
		"editor.foreground": "#F5E9EC",
		"editorLineNumber.activeForeground": "#FF9EAE",
		"editorCursor.foreground": "#FF718D",
		"editor.selectionBackground": "#542C3A",
		"editor.selectionHighlightBackground": "#FF718D33",
		"editorIndentGuide.activeBackground1": "#FF718D",
		"editorGutter.addedBackground": "#64C99A",
		"editorGutter.modifiedBackground": "#FFC06B",
		"editorGutter.deletedBackground": "#FF718D",
		"activityBar.background": "#1D151B",
		"activityBar.activeBorder": "#FF718D",
		"activityBarBadge.background": "#CE4F6C",
		"activityBarBadge.foreground": "#FFFFFF",
		"sideBar.background": "#21171E",
		"sideBar.border": "#49313B",
		"sideBarSectionHeader.background": "#2A1C24",
		"tab.activeBackground": "#181216",
		"tab.activeBorderTop": "#FF718D",
		"list.activeSelectionBackground": "#452833",
		"list.hoverBackground": "#35212A",
		"button.background": "#B8425B",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#D2526D",
		"badge.background": "#86384D",
		"input.background": "#21171E",
		"input.border": "#5B3946",
		"inputOption.activeBorder": "#FF718D",
		"dropdown.background": "#21171E",
		"dropdown.border": "#5B3946",
		"menu.background": "#21171E",
		"menu.selectionBackground": "#452833",
		"panel.background": "#1D151B",
		"panel.border": "#49313B",
		"statusBar.background": "#2B1B24",
		"statusBarItem.remoteBackground": "#9B4058",
		"titleBar.activeBackground": "#1D151B",
		"terminal.ansiYellow": "#FFC06B",
		"terminal.ansiBrightYellow": "#FFD28C",
		"terminal.ansiCyan": "#78DAD0",
		"textLink.foreground": "#FF9EAE",
		"textLink.activeForeground": "#FFC0CA",
		"editorWidget.background": "#21171E"
	}
}
