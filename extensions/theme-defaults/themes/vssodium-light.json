{
	"$schema": "vscode://schemas/color-theme",
	"name": "VsSodium Light",
	"include": "./light_modern.json",
	"type": "light",
	"tokenColors": [
		{
			"scope": "entity.name.tag.svg",
			"settings": {
				"foreground": "#007F73",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "entity.other.attribute-name.svg",
			"settings": {
				"foreground": "#8A5500"
			}
		}
	],
	"colors": {
		"foreground": "#202A34",
		"disabledForeground": "#808A95",
		"descriptionForeground": "#596775",
		"icon.foreground": "#506070",
		"focusBorder": "#A86200",
		"editor.background": "#FAFBFC",
		"editor.foreground": "#202A34",
		"editorLineNumber.foreground": "#8995A2",
		"editorLineNumber.activeForeground": "#8A5500",
		"editorCursor.foreground": "#A86200",
		"editor.selectionBackground": "#C8E7E2",
		"editor.inactiveSelectionBackground": "#DDE9E8",
		"editor.selectionHighlightBackground": "#007F7330",
		"editorIndentGuide.background1": "#E0E5EA",
		"editorIndentGuide.activeBackground1": "#00877A",
		"activityBar.background": "#F0F3F6",
		"activityBar.foreground": "#394858",
		"activityBar.activeBorder": "#A86200",
		"activityBarBadge.background": "#A86200",
		"activityBarBadge.foreground": "#FFFFFF",
		"sideBar.background": "#F3F6F8",
		"sideBar.foreground": "#263442",
		"sideBar.border": "#D9E0E6",
		"sideBarSectionHeader.background": "#EAF0F4",
		"sideBarSectionHeader.border": "#D9E0E6",
		"editorGroupHeader.tabsBackground": "#F3F6F8",
		"tab.activeBackground": "#FAFBFC",
		"tab.activeForeground": "#202A34",
		"tab.activeBorderTop": "#A86200",
		"tab.inactiveForeground": "#697786",
		"tab.border": "#D9E0E6",
		"list.activeSelectionBackground": "#DDEBEA",
		"list.activeSelectionForeground": "#202A34",
		"list.inactiveSelectionBackground": "#EAF0F4",
		"list.hoverBackground": "#E7F0F0",
		"button.background": "#9A5B00",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#824D00",
		"badge.background": "#007F73",
		"badge.foreground": "#FFFFFF",
		"input.background": "#FFFFFF",
