		"panel.border": "#D9E0E6",
		"statusBar.background": "#EAF0F4",
		"statusBar.foreground": "#263442",
		"statusBar.noFolderBackground": "#EAF0F4",
		"statusBarItem.remoteBackground": "#007F73",
		"titleBar.activeBackground": "#F3F6F8",
		"titleBar.activeForeground": "#202A34",
		"terminal.ansiYellow": "#8A5500",
		"terminal.ansiBrightYellow": "#A86200",
		"terminal.ansiCyan": "#007F73",
		"terminal.ansiBrightCyan": "#009688",
		"textLink.foreground": "#007F73",
		"textLink.activeForeground": "#00675E",
		"widget.border": "#C7D1DB",
