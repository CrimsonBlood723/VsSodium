		"button.background": "#805BB8",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#946BCF",
		"badge.background": "#644891",
		"input.background": "#191624",
		"input.border": "#514466",
		"inputOption.activeBorder": "#C4A7FF",
		"dropdown.background": "#1B1827",
		"dropdown.border": "#514466",
		"menu.background": "#1B1827",
		"menu.selectionBackground": "#39304A",
		"panel.background": "#171422",
		"panel.border": "#393046",
		"statusBar.background": "#211B30",
		"statusBarItem.remoteBackground": "#67499A",
		"titleBar.activeBackground": "#171422",
		"terminal.ansiYellow": "#FFD166",
		"terminal.ansiCyan": "#8DD9FF",
		"textLink.foreground": "#C4A7FF",
		"textLink.activeForeground": "#E0CCFF",
		"editorWidget.background": "#1B1827"
