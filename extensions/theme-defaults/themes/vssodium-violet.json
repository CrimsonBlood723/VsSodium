{
	"$schema": "vscode://schemas/color-theme",
	"name": "VsSodium Violet",
	"include": "./vssodium-dark.json",
	"type": "dark",
	"tokenColors": [
		{
			"scope": "entity.name.tag.svg",
			"settings": { "foreground": "#D8B4FE", "fontStyle": "bold" }
		},
		{
			"scope": "entity.other.attribute-name.svg",
			"settings": { "foreground": "#9AC7FF" }
		}
	],
	"colors": {
		"foreground": "#EEE9F8",
		"descriptionForeground": "#B5A9C7",
		"focusBorder": "#C4A7FF",
		"editor.background": "#12101C",
		"editor.foreground": "#EEE9F8",
		"editorLineNumber.activeForeground": "#D8B4FE",
		"editorCursor.foreground": "#D8B4FE",
		"editor.selectionBackground": "#49375F",
		"editor.selectionHighlightBackground": "#C4A7FF33",
		"editorIndentGuide.activeBackground1": "#B794F4",
		"activityBar.background": "#171422",
		"activityBar.activeBorder": "#C4A7FF",
		"activityBarBadge.background": "#9B72D8",
		"activityBarBadge.foreground": "#FFFFFF",
		"sideBar.background": "#1B1827",
		"sideBar.border": "#393046",
		"sideBarSectionHeader.background": "#211D30",
		"tab.activeBackground": "#12101C",
		"tab.activeBorderTop": "#C4A7FF",
		"list.activeSelectionBackground": "#39304A",
