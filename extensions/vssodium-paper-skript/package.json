{
	"name": "vssodium-paper-skript",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.0",
	"publisher": "vssodium",
	"license": "MIT",
	"engines": { "vscode": "*" },
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:skript",
		"onCommand:vssodium.skript.openBlockBuilder",
		"onCommand:vssodium.skript.createCustomBlock"
	],
	"contributes": {
		"languages": [
			{
				"id": "skript",
				"aliases": ["Skript", "skript"],
				"extensions": [".sk"],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{ "language": "skript", "scopeName": "source.skript", "path": "./syntaxes/skript.tmLanguage.json" }
		],
		"snippets": [
			{ "language": "skript", "path": "./snippets/skript.code-snippets" }
		],
		"commands": [
			{ "command": "vssodium.skript.openBlockBuilder", "title": "%openBuilder%", "category": "VsSodium Skript" },
			{ "command": "vssodium.skript.createCustomBlock", "title": "%createCustomBlock%", "category": "VsSodium Skript" }
		],
		"menus": {
			"editor/title": [
				{ "command": "vssodium.skript.openBlockBuilder", "when": "editorLangId == skript", "group": "navigation" }
			]
		}
	}
}
