{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "source.skript",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#variables" },
		{ "include": "#events" },
		{ "include": "#commands" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#numbers" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": { "patterns": [{ "name": "comment.line.number-sign.skript", "match": "#.*$" }] },
		"strings": {
			"name": "string.quoted.double.skript",
			"begin": "\"",
			"end": "\"",
			"patterns": [{ "name": "constant.character.escape.skript", "match": "\\\\." }, { "name": "variable.other.skript", "match": "\\{[^}]+\\}" }]
		},
		"variables": { "patterns": [{ "name": "variable.other.skript", "match": "\\{[a-zA-Z0-9_ .:-]+\\}" }] },
		"events": { "patterns": [{ "name": "keyword.control.event.skript", "match": "(?i)^\\s*(on|every)\\b" }, { "name": "entity.name.function.event.skript", "match": "(?i)(join|quit|chat|death|respawn|break|place|interact|damage|click|inventory|craft|consume|drop|pickup|move|world change)\\b" }] },
		"commands": { "patterns": [{ "name": "keyword.control.command.skript", "match": "(?i)^\\s*command\\s+(/[^:\\s]+)" , "captures": { "1": { "name": "entity.name.function.skript" } } }, { "name": "keyword.control.command.skript", "match": "(?i)^\\s*trigger\\s*:" }] },
		"keywords": { "patterns": [{ "name": "keyword.control.skript", "match": "(?i)\\b(if|else|else if|then|loop|while|do|stop|return|wait|cancel|set|delete|add|remove|give|send|broadcast|teleport|heal|kill|spawn|play|execute|function|options|variables|on|every|trigger)\\b" }, { "name": "keyword.operator.logical.skript", "match": "(?i)\\b(and|or|not|is|isn't|equals|contains|in|greater than|less than|at least|at most)\\b" }] },
		"types": { "patterns": [{ "name": "support.type.skript", "match": "(?i)\\b(player|entity|world|location|block|item|inventory|gamemode|number|text|boolean|timespan|weather|potion|sound|vector|offline player)\\b" }] },
		"numbers": { "patterns": [{ "name": "constant.numeric.skript", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" }] },
		"operators": { "patterns": [{ "name": "keyword.operator.skript", "match": "(?i)(==|!=|<=|>=|<|>|\\+|-|\\*|/|\\bto\\b|\\bby\\b|\\bwith\\b)" }] }
	}
}
